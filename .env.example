# MySQL
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=longdcam
MYSQL_USER=longdcam
MYSQL_PASSWORD=changeme_user

# Backend
JWT_SECRET=changeme_jwt_secret
TURN_SECRET=changeme_turn_secret
API_PORT=3000

# ObjectStore (MinIO)
OBJECTSTORE_ENDPOINT=https://objectstore.ghmate.com
OBJECTSTORE_ACCESS_KEY=
OBJECTSTORE_SECRET_KEY=
OBJECTSTORE_BUCKET=longdcam

# Database (API on host network → MySQL container)
DB_HOST=127.0.0.1
DB_PORT=3306

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://longdcam-back.ghmate.com/api/auth/google/callback
FRONTEND_URL=https://longdcam-front.ghmate.com

# LiveKit SFU
# Backend SDK (token signing + RoomServiceClient) uses API_KEY/API_SECRET.
# The livekit-server container reads LIVEKIT_KEYS ("key: secret" — same pair).
# Secret must be >= 32 chars. Generate prod values, never commit real ones.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=localdevsecret0123456789abcdefghij
LIVEKIT_KEYS=devkey: localdevsecret0123456789abcdefghij

# Compose-level var (lives in longdcam_service/.env, NOT backend/.env):
# the server's LAN IP that LiveKit advertises as its ICE candidate via --node-ip.
# LK_NODE_IP=192.168.0.15
