# MySQL
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=ghc
MYSQL_USER=ghc
MYSQL_PASSWORD=changeme_user

# Backend
JWT_SECRET=changeme_jwt_secret
TURN_SECRET=changeme_turn_secret
API_PORT=3000

# ObjectStore (MinIO)
OBJECTSTORE_ENDPOINT=https://objectstore.ghmate.com
OBJECTSTORE_ACCESS_KEY=
OBJECTSTORE_SECRET_KEY=
OBJECTSTORE_BUCKET=ghc

# Database (API on host network → MySQL container)
DB_HOST=127.0.0.1
DB_PORT=3306

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ghc-api.ghmate.com/api/auth/google/callback
FRONTEND_URL=https://ghc.ghmate.com

# LiveKit SFU
# Backend SDK (token signing + RoomServiceClient) uses API_KEY/API_SECRET.
# The livekit-server container reads LIVEKIT_KEYS ("key: secret" — same pair).
# Secret must be >= 32 chars. Generate prod values, never commit real ones.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=localdevsecret0123456789abcdefghij
LIVEKIT_KEYS=devkey: localdevsecret0123456789abcdefghij

# OBS live broadcast via LiveKit Ingress (RTMP).
# Public host OBS connects to (rtmp://<host>:1935). Point a DNS-only/grey-cloud A record at
# the home server and forward 1935/tcp on the router. The backend rewrites the ingress URL
# host to this value when handing credentials to OBS.
INGRESS_RTMP_HOST=ghc-rtmp.ghmate.com
# Public HLS proxy included in ingress participant metadata for room viewers.
HLS_MASTER_BASE_URL=https://ghc-api.ghmate.com/api/live
# NOTE: docker-compose interpolates LIVEKIT_API_KEY / LIVEKIT_API_SECRET into the ingress
# service's config (INGRESS_CONFIG_BODY). Those must also exist in ghc_service/.env
# (the compose project env), alongside MYSQL_*.

# Compose-level var for LOCAL dev only (ghc_service/.env, set by local-setup.sh):
# the Mac's LAN IP that the local LiveKit advertises via --node-ip so a phone on the same
# WiFi can reach it. Prod doesn't use this — it advertises the public IP (use_external_ip).
# LK_NODE_IP=192.168.0.15
